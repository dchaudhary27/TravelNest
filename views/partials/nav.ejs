<header class="bg-gradient-to-r from-red-600 to-red-500 text-white shadow-lg">
    <nav class="container mx-auto flex justify-between items-center px-6 py-4">
        <div class="flex items-center space-x-8">
            <a
                href="/"
                class="text-2xl font-bold hover:text-red-100 transition duration-300 <%= typeof activeTab !== 'undefined' && activeTab === 'TravelNest' ? 'text-red-100' : '' %>"
            >
                ✈️ TravelNest
            </a>
            
            <% if (isLoggedIn) { %>
            <ul class="hidden md:flex space-x-1">
                <%if( user && user.userType === "traveler"){%>
                <li>
                    <a
                        href="/home-list"
                        class="hover:bg-red-400 py-2 px-4 rounded-lg transition duration-300 <%= typeof activeTab !== 'undefined' && activeTab === 'home' ? 'bg-red-400' : '' %>"
                    >
                        Home
                    </a>
                </li>
               
                <li>
                    <a
                        href="/bookings"
                        class="hover:bg-red-400 py-2 px-4 rounded-lg transition duration-300 <%= typeof activeTab !== 'undefined' && activeTab === 'bookings' ? 'bg-red-400' : '' %>"
                    >
                        Bookings
                    </a>
                </li>
                <li>
                    <a
                        href="/favourites"
                        class="hover:bg-red-400 py-2 px-4 rounded-lg transition duration-300 <%= typeof activeTab !== 'undefined' && activeTab === 'favourite-list' ? 'bg-red-400' : '' %>"
                    >
                        ❤️ Favourites
                    </a>
                </li>
                <%} else {%>
                     <li>
                    <a
                        href="/host/host-home-list"
                        class="hover:bg-red-400 py-2 px-4 rounded-lg transition duration-300 <%= typeof activeTab !== 'undefined' && activeTab === 'host-home-list' ? 'bg-red-400' : '' %>"
                    >
                        My Listings
                    </a>
                </li>
                <li>
                    <a
                        href="/host/add-home"
                        class="hover:bg-red-400 py-2 px-4 rounded-lg transition duration-300 <%= typeof activeTab !== 'undefined' && activeTab === 'add-home' ? 'bg-red-400' : '' %>"
                    >
                        Add Home
                    </a>
                </li>
                <%}%>
            </ul>
            <% } %>
        </div>

        <div class="flex items-center space-x-3">
            <% if (!isLoggedIn) { %>
            <a
                href="/login"
                 class="bg-white text-red-600 font-semibold py-2 px-6 rounded-lg hover:bg-red-50 transition duration-300"
            >
                Sign In
            </a>
            <a
                href="/signup"
                class="bg-white text-red-600 font-semibold py-2 px-6 rounded-lg hover:bg-red-50 transition duration-300"
            >
                Sign Up
            </a>
            <% } else { %>
            <form action="/logout" method="POST">
                <button
                    type="submit"
                    class="bg-white text-red-600 font-semibold py-2 px-6 rounded-lg hover:bg-red-50 transition duration-300"
                >
                    Sign Out
                </button>
            </form>
            <% } %>
        </div>
    </nav>
</header>
